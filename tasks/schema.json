{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroAgentBench task spec",
  "description": "tasks/<task_id>/spec.yaml. Strings starting with <<FILL mark values still to be decided; the batch guard rejects any spec that has one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "selection", "modality", "source", "question", "prediction_format", "data", "metric",
               "baselines", "noise_ceiling", "budgets", "tools", "scramble", "contamination"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "selection": {"enum": ["dummy", "pilot_pre_rule", "rule"],
                  "description": "dummy: harness test; pilot_pre_rule: pilot task chosen before the selection rule (reported separately); rule: admitted by docs/TASK_SELECTION.md"},
    "synthetic": {"type": "boolean", "default": false},
    "modality": {"enum": ["fmri", "eeg", "meg", "spikes", "calcium", "behaviour", "bci"]},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["name", "url", "licence", "released"],
      "properties": {
        "name": {"$ref": "#/$defs/str"},
        "url": {"$ref": "#/$defs/str"},
        "licence": {"$ref": "#/$defs/str"},
        "released": {
          "type": "object", "additionalProperties": false, "required": ["data", "test_labels"],
          "properties": {
            "data": {"$ref": "#/$defs/date"},
            "test_labels": {"anyOf": [{"$ref": "#/$defs/date"}, {"enum": ["never", "unknown"]}]}
          }
        }
      }
    },
    "question": {"$ref": "#/$defs/str", "description": "Agent-facing task text; identical across conditions and models."},
    "prediction_format": {"$ref": "#/$defs/str", "description": "Agent-facing description of the prediction column."},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["dev_inputs", "dev_labels", "test_inputs", "truth"],
      "properties": {
        "dev_inputs": {"$ref": "#/$defs/paths"},
        "dev_labels": {"$ref": "#/$defs/paths"},
        "test_inputs": {"$ref": "#/$defs/paths"},
        "truth": {"$ref": "#/$defs/str", "description": "Test labels as CSV (case_id,label) under {truth_root}; never staged."}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false, "required": ["function", "higher_is_better", "description"],
      "properties": {
        "function": {"$ref": "#/$defs/ref"},
        "higher_is_better": {"anyOf": [{"type": "boolean"}, {"$ref": "#/$defs/fill"}]},
        "description": {"$ref": "#/$defs/str"}
      }
    },
    "baselines": {
      "type": "object", "additionalProperties": false, "required": ["simple", "sota", "automl"],
      "properties": {
        "simple": {"type": "object", "additionalProperties": false, "required": ["function", "description"],
                   "properties": {"function": {"$ref": "#/$defs/ref"}, "description": {"$ref": "#/$defs/str"}}},
        "sota": {
          "type": "object", "additionalProperties": false, "required": ["name", "code", "function", "published"],
          "properties": {
            "name": {"$ref": "#/$defs/str"},
            "code": {"$ref": "#/$defs/str", "description": "Repository URL and commit of the published code."},
            "function": {"$ref": "#/$defs/ref", "description": "Rerun on this task's split."},
            "hardware": {"$ref": "#/$defs/str", "description": "Where the rerun and the agents ran, when they differ; printed in the report."},
            "published": {
              "type": "object", "additionalProperties": false, "required": ["value", "source"],
              "properties": {"value": {"anyOf": [{"type": "number"}, {"type": "null"}, {"$ref": "#/$defs/fill"}]},
                             "source": {"$ref": "#/$defs/str"}}
            }
          }
        },
        "automl": {
          "type": "object", "additionalProperties": false, "required": ["function", "budget"],
          "properties": {
            "function": {"$ref": "#/$defs/ref"},
            "budget": {"type": "object", "additionalProperties": false, "required": ["wall_time_s", "gpu_hours"],
                       "properties": {"wall_time_s": {"$ref": "#/$defs/int"}, "gpu_hours": {"$ref": "#/$defs/num"}},
                       "description": "Must equal the agent budget."}
          }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Prediction sets made in the baseline step and scored like the baselines, never used in normalization. Each function is called as fn(workspace, budget, baseline_workspaces). Names starting with sota_seed are per-seed SOTA predictions; the reference with leakage_margin is the signal-free one the C3 leakage check compares against.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "function", "description"],
        "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "function": {"$ref": "#/$defs/ref"},
                       "description": {"$ref": "#/$defs/str"}, "leakage_margin": {"$ref": "#/$defs/num"}}
      }
    },
    "noise_ceiling": {
      "type": "object", "additionalProperties": false, "required": ["method", "function"],
      "properties": {"method": {"$ref": "#/$defs/str"},
                     "function": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}],
                                  "description": "Returns ceiling predictions {case_id: prediction}; null if no ceiling exists."}}
    },
    "budgets": {
      "type": "object", "additionalProperties": false, "required": ["tokens", "wall_time_s", "gpu_hours", "submission_limit"],
      "properties": {
        "tokens": {"$ref": "#/$defs/int", "description": "Logged per CLI, not enforced."},
        "wall_time_s": {"$ref": "#/$defs/int", "description": "Hard limit per run."},
        "gpu_hours": {"$ref": "#/$defs/num"},
        "submission_limit": {"$ref": "#/$defs/int", "description": "Hard limit on scored submissions per task x condition x model (all reps together)."}
      }
    },
    "tools": {
      "type": "object", "additionalProperties": false, "required": ["generic", "trained_models"],
      "properties": {
        "generic": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/str"}}, {"$ref": "#/$defs/fill"}]},
        "trained_models": {"anyOf": [{"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "files", "call", "interface"],
          "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                         "files": {"$ref": "#/$defs/paths"},
                         "call": {"$ref": "#/$defs/str", "description": "Command run from the workspace root."},
                         "interface": {"$ref": "#/$defs/str", "description": "Inputs, outputs and shapes, shown to the agent."}}}},
          {"$ref": "#/$defs/fill"}]}
      }
    },
    "scramble": {
      "type": "object", "additionalProperties": false, "required": ["method", "function", "description"],
      "properties": {"method": {"anyOf": [{"enum": ["label_permutation", "phase_randomization", "other"]}, {"$ref": "#/$defs/fill"}]},
                     "function": {"$ref": "#/$defs/ref"},
                     "description": {"$ref": "#/$defs/str"}}
    },
    "contamination": {
      "type": "object", "additionalProperties": false,
      "required": ["model_cutoffs_vs_release", "test_labels_public", "split_provenance"],
      "properties": {"model_cutoffs_vs_release": {"$ref": "#/$defs/str"},
                     "test_labels_public": {"anyOf": [{"type": "boolean"}, {"enum": ["unknown"]}, {"$ref": "#/$defs/fill"}]},
                     "split_provenance": {"$ref": "#/$defs/str"}}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "fill": {"type": "string", "pattern": "^<<FILL"},
    "str": {"type": "string", "minLength": 1},
    "int": {"anyOf": [{"type": "integer", "minimum": 0}, {"$ref": "#/$defs/fill"}]},
    "num": {"anyOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/fill"}]},
    "date": {"anyOf": [{"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, {"$ref": "#/$defs/fill"}]},
    "ref": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$"}, {"$ref": "#/$defs/fill"}]},
    "paths": {"anyOf": [{"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/str"}}, {"$ref": "#/$defs/fill"}]}
  }
}
